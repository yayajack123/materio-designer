# Starter defaults; replace identity and backend values for each deployment.
NUXT_PUBLIC_APP_NAME="Materio Designer"
NUXT_PUBLIC_APP_LOGO=
NUXT_PUBLIC_APP_FAVICON=/favicon.ico
NUXT_PUBLIC_BRAND_PRIMARY="#10AF13"

# Authentication stays disabled until a backend is configured.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=
SANCTUM_BASE_URL=
AUTH_ENABLED=false

# Local development Basic Auth only. Replace for shared environments.
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=change-me
